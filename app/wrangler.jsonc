// Cloudflare Workers (static assets): cada push a main → Workers Builds compila y publica `dist/`.
// Ver DEPLOY.md. Las VITE_* deben estar en "Build variables" (no en las variables de runtime).
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "frieren",
  "compatibility_date": "2025-09-01",
  "build": {
    "command": "npm run build"
  },
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  }
}
